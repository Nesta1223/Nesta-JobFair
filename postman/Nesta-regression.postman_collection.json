{
  "info": {
    "name": "Nesta | Regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Nesta Project 3. Start npm run demo. Requests disable cookies so token isolation and logout tests are deterministic. Fictional demo credentials only."
  },
  "item": [
    {
      "name": "01 Registration validation: missing telephone",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{URL}}/api/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Student\",\n  \"email\": \"{{RUN_EMAIL}}\",\n  \"password\": \"{{USER_PASSWORD}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "01 Registration validation: missing telephone"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('RUN_EMAIL', 'demo.' + Date.now() + '@nesta.example');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Response under 3 seconds', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
              "const json = pm.response.json();",
              "pm.test('Success flag', () => pm.expect(json.success).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register student",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{URL}}/api/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Nesta Demo Student\",\n  \"tel\": \"0812345678\",\n  \"email\": \"{{RUN_EMAIL}}\",\n  \"password\": \"{{USER_PASSWORD}}\",\n  \"role\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "02 Register student"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Response under 3 seconds', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
              "const json = pm.response.json();",
              "pm.test('Success flag', () => pm.expect(json.success).to.eql(true));",
              "pm.collectionVariables.set('USER_ID', json.data._id);",
              "pm.test('Cannot self-assign admin', () => pm.expect(json.data.role).to.eql('user'));",
              "pm.test('Telephone stored', () => pm.expect(json.data.tel).to.eql('0812345678'));"
            ]
          }
        }
      ]
    },
